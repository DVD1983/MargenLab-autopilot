{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "orchestrator": {
      "model": "opencode/big-pickle",
      "description": "CTO y orquestador de Autopilot"
    },
    "auditor": {
      "model": "opencode/mimo-v2.5-free",
      "description": "Lee CSV completos con 1M contexto"
    },
    "finanzas": {
      "model": "opencode/ling-3.0-flash-fin-free",
      "description": "Calcula margen, churn y pricing"
    },
    "dev": {
      "model": "opencode/gpt-5-codex",
      "description": "Construye dashboard, APIs y conectores"
    },
    "vendedor": {
      "model": "opencode/muse-spark-1.3-free",
      "description": "Copy argentino que vende"
    },
    "reporter": {
      "model": "opencode/kimi-k3",
      "description": "Arma reporte final y video script"
    }
  }
}